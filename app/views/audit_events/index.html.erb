<%= render "layouts/page_header", eyebrow: "RASTREABILIDADE", title: "Histórico de eventos", description: "Acompanhe as ações registradas no workspace." %><section class="panel"><% if @audit_events.any? %><div class="table-wrap"><table class="data-table"><thead><tr><th>Evento</th><th>Entidade</th><th>Ator</th><th>Quando</th></tr></thead><tbody><% @audit_events.each do |event| %><tr><td class="entity-name"><%= event.action.tr(".", " ") %></td><td><%= event.auditable_type %> #<%= event.auditable_id %></td><td><%= event.user&.name || "Sistema" %></td><td><span class="entity-meta"><%= l event.created_at, format: :short %></span></td></tr><% end %></tbody></table></div><% else %><%= render "layouts/empty_state", title: "Sem eventos registrados", message: "As ações importantes da operação aparecerão nesta linha do tempo." %><% end %></section>
