<%= render "layouts/page_header", eyebrow: "RASTREABILIDADE", title: "Histórico de eventos", description: "Acompanhe as ações registradas no workspace." %><section class="panel"><% if @audit_events.any? %><div class="table-wrap"><table class="data-table"><thead><tr><th>Evento</th><th>Entidade</th><th>Ator</th><th>Quando</th></tr></thead><tbody><% @audit_events.each do |event| %><tr><td class="entity-name"><%= audit_action_label(event.action) %></td><td><%= entity_label(event.auditable_type) %> #<%= event.auditable_id %></td><td><%= event.user&.name || "Sistema" %></td><td><span class="entity-meta"><%= format_datetime(event.created_at) %></span></td></tr><% end %></tbody></table></div><% else %><%= render "layouts/empty_state", title: "Sem eventos registrados", message: "As ações importantes da operação aparecerão nesta linha do tempo." %><% end %></section>
