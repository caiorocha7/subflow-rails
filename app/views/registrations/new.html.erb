<section class="auth-card"><a class="brand" href="/">Sub<span>Flow</span></a><p class="eyebrow">COMECE EM MINUTOS</p><h1>Crie seu workspace</h1><% if @error %><div class="flash alert"><%= @error %></div><% end %><%= form_with url: signup_path do |f| %><label>Empresa<%= f.text_field :account_name, required: true %></label><label>Seu nome<%= f.text_field :name, required: true %></label><label>E-mail<%= f.email_field :email, required: true %></label><label>Senha<%= f.password_field :password, required: true, minlength: 8 %></label><%= f.submit "Criar empresa", class: "button primary" %><% end %><p class="muted"><%= link_to "Voltar ao login", login_path %></p></section>
