<%= render "layouts/page_header", eyebrow: "RECEITA RECORRENTE", title: "Assinaturas", description: "Acompanhe o ciclo de vida de cada cliente.", action: (link_to("Nova assinatura", new_subscription_path, class: "button primary") if current_user.admin?) %><section class="panel"><% if @subscriptions.any? %><div class="table-wrap"><table class="data-table"><thead><tr><th>Cliente</th><th>Plano</th><th>Status</th><th>Próxima cobrança</th><th></th></tr></thead><tbody><% @subscriptions.each do |s| %><tr><td><span class="entity-name"><%= s.customer.name %></span><span class="entity-meta">Assinatura #<%= s.id %></span></td><td><%= s.plan.name %></td><td><%= status_badge(s.status) %></td><td><span class="entity-name"><%= format_date(s.next_billing_on) %></span></td><td><%= link_to "Ver assinatura →", s, class: "table-link" %></td></tr><% end %></tbody></table></div><% else %><%= render "layouts/empty_state", title: "Nenhuma assinatura", message: "Crie a primeira assinatura quando houver um cliente e um plano.", action: (link_to("Nova assinatura", new_subscription_path, class: "button primary") if current_user.admin?) %><% end %></section>
