<% actions = []; actions << button_to("Ativar", activate_subscription_path(@subscription), method: :patch, class: "button primary") if current_user.admin? && @subscription.trialing?; actions << button_to("Cancelar", cancel_subscription_path(@subscription), method: :patch, class: "button danger", data: { turbo_confirm: "Cancelar esta assinatura?" }) if current_user.admin? && !@subscription.canceled? %><%= render "layouts/page_header", eyebrow: "ASSINATURA ##{@subscription.id}", title: "#{@subscription.customer.name} · #{@subscription.plan.name}", description: "Acompanhe o status e as cobranças relacionadas.", action: (safe_join(actions, " ") if actions.any?) %><section class="panel detail-grid"><div><span class="detail-label">Situação</span><%= status_badge(@subscription.status) %></div><div><span class="detail-label">Início</span><strong><%= format_date(@subscription.starts_on) %></strong></div><div><span class="detail-label">Próxima cobrança</span><strong><%= format_date(@subscription.next_billing_on) %></strong></div></section><section class="panel"><div class="section-heading"><h2>Cobranças relacionadas</h2></div><% if @invoices.any? %><div class="table-wrap"><table class="data-table"><thead><tr><th>Período</th><th>Valor</th><th>Status</th><th></th></tr></thead><tbody><% @invoices.each do |invoice| %><tr><td><%= format_date(invoice.period_start) %> — <%= format_date(invoice.period_end) %></td><td class="entity-name"><%= money(invoice.amount_cents) %></td><td><%= status_badge(invoice.status) %></td><td><%= link_to "Ver fatura →", invoice, class: "table-link" %></td></tr><% end %></tbody></table></div><% else %><%= render "layouts/empty_state", title: "Nenhuma cobrança ainda", message: "As faturas serão exibidas aqui quando forem geradas." %><% end %></section>
