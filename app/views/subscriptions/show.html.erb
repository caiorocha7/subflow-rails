<div class="page-head"><div><p class="eyebrow">ASSINATURA #<%= @subscription.id %></p><h1><%= @subscription.customer.name %> · <%= @subscription.plan.name %></h1><p><%= status_badge(@subscription.status) %></p></div><div><%= button_to "Ativar", activate_subscription_path(@subscription), method: :patch, class: "button primary" if current_user.admin? && @subscription.trialing? %> <%= button_to "Cancelar", cancel_subscription_path(@subscription), method: :patch, class: "button danger", data: { turbo_confirm: "Cancelar esta assinatura?" } if current_user.admin? && !@subscription.canceled? %></div></div><section class="panel detail-grid"><div><span>Início</span><strong><%= l @subscription.starts_on %></strong></div><div><span>Próxima cobrança</span><strong><%= l @subscription.next_billing_on %></strong></div><div><span>Plano</span><strong><%= money(@subscription.plan.amount_cents) %>/<%= @subscription.plan.interval %></strong></div></section><section class="panel"><h2>Cobranças</h2><table><thead><tr><th>Período</th><th>Valor</th><th>Status</th><th></th></tr></thead><tbody><% @invoices.each do |invoice| %><tr><td><%= invoice.period_start %> — <%= invoice.period_end %></td><td><%= money(invoice.amount_cents) %></td><td><%= status_badge(invoice.status) %></td><td><%= link_to "Ver", invoice %></td></tr><% end %></tbody></table></section>
