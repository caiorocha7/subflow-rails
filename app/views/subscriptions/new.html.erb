<%= render "layouts/page_header", eyebrow: "RECEITA RECORRENTE", title: "Nova assinatura", description: "Inicie uma assinatura com período de teste." %><section class="panel form-card"><%= form_with model: @subscription, class: "form-grid" do |f| %><% if @subscription.errors.any? %><div class="form-error wide"><%= @subscription.errors.full_messages.to_sentence %></div><% end %><label>Cliente<%= f.collection_select :customer_id, @customers, :id, :name, { prompt: "Selecione um cliente" }, required: true %></label><label>Plano<%= f.collection_select :plan_id, @plans, :id, :name, { prompt: "Selecione um plano" }, required: true %></label><label>Início<%= f.date_field :starts_on, required: true %></label><div class="form-actions"><%= f.submit "Criar assinatura", class: "button primary" %><%= link_to "Cancelar", subscriptions_path, class: "button" %></div><% end %></section>
