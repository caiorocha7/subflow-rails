<div class="page-head"><h1>Nova assinatura</h1></div><section class="panel"><%= form_with model: @subscription, class: "form-grid" do |f| %><% if @subscription.errors.any? %><div class="form-error"><%= @subscription.errors.full_messages.to_sentence %></div><% end %><label>Cliente<%= f.collection_select :customer_id, @customers, :id, :name, { prompt: "Selecione" }, required: true %></label><label>Plano<%= f.collection_select :plan_id, @plans, :id, :name, { prompt: "Selecione" }, required: true %></label><label>Início<%= f.date_field :starts_on, required: true %></label><div><%= f.submit "Criar assinatura", class: "button primary" %></div><% end %></section>
