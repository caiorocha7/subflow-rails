<%= form_with model: customer, class: "form-grid" do |f| %><% if customer.errors.any? %><div class="form-error"><%= customer.errors.full_messages.to_sentence %></div><% end %><label>Nome ou razão social<%= f.text_field :name, required: true %></label><label>E-mail<%= f.email_field :email, required: true %></label><label>Documento<%= f.text_field :document %></label><label>Telefone<%= f.telephone_field :phone %></label><label>Status<%= f.select :status, Customer.statuses.keys.map { |s| [s.humanize, s] } %></label><div><%= f.submit class: "button primary" %></div><% end %>
