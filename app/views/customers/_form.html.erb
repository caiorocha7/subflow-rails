<%= form_with model: customer, class: "form-grid" do |f| %><% if customer.errors.any? %><div class="form-error wide"><%= customer.errors.full_messages.to_sentence %></div><% end %><label>Nome ou razão social<%= f.text_field :name, required: true, autofocus: true %></label><label>E-mail<%= f.email_field :email, required: true %></label><label>Documento<span class="field-hint">Opcional</span><%= f.text_field :document %></label><label>Telefone<span class="field-hint">Opcional</span><%= f.telephone_field :phone %></label><label>Status<%= f.select :status, Customer.statuses.keys.map { |s| [s.humanize, s] } %></label><div class="form-actions"><%= f.submit class: "button primary" %><%= link_to "Cancelar", customers_path, class: "button" %></div><% end %>
