<%= render "layouts/page_header", eyebrow: "BASE DE CLIENTES", title: "Clientes", description: "Gerencie os contatos da sua operação.", action: (link_to("Novo cliente", new_customer_path, class: "button primary") if current_user.admin?) %><section class="panel"><%= form_with url: customers_path, method: :get, class: "filters" do |f| %><%= f.search_field :q, value: params[:q], placeholder: "Buscar nome ou e-mail", aria: { label: "Buscar clientes" } %><%= f.select :status, Customer.statuses.keys.map { |s| [s.humanize, s] }, { include_blank: "Todos os status", selected: params[:status] }, aria: { label: "Filtrar status" } %><%= f.submit "Filtrar", class: "button" %><% end %><% if @customers.any? %><div class="table-wrap"><table class="data-table"><thead><tr><th>Cliente</th><th>Status</th><th>Cadastro</th><th></th></tr></thead><tbody><% @customers.each do |customer| %><tr><td><span class="entity-name"><%= customer.name %></span><span class="entity-meta"><%= customer.email %></span></td><td><%= status_badge(customer.status) %></td><td><%= l customer.created_at.to_date %></td><td><%= link_to "Detalhes", customer, class: "table-link" %></td></tr><% end %></tbody></table></div><% else %><%= render "layouts/empty_state", title: "Nenhum cliente encontrado", message: "Ajuste os filtros ou cadastre o primeiro cliente.", action: (link_to("Novo cliente", new_customer_path, class: "button primary") if current_user.admin?) %><% end %></section>
