<div class="page-head"><div><p class="eyebrow">BASE DE CLIENTES</p><h1>Clientes</h1></div><%= link_to "Novo cliente", new_customer_path, class: "button primary" if current_user.admin? %></div><section class="panel"><%= form_with url: customers_path, method: :get, class: "filters" do |f| %><%= f.search_field :q, value: params[:q], placeholder: "Buscar nome ou e-mail" %><%= f.select :status, Customer.statuses.keys.map { |s| [s.humanize, s] }, { include_blank: "Todos os status", selected: params[:status] } %><%= f.submit "Filtrar", class: "button" %><% end %><table><thead><tr><th>Cliente</th><th>Status</th><th>Criado em</th><th></th></tr></thead><tbody><% @customers.each do |customer| %><tr><td><strong><%= customer.name %></strong><small><%= customer.email %></small></td><td><%= status_badge(customer.status) %></td><td><%= l customer.created_at.to_date %></td><td><%= link_to "Ver", customer %></td></tr><% end %></tbody></table></section>
