<%= render "layouts/page_header", eyebrow: "CLIENTE", title: @customer.name, description: @customer.email, action: (safe_join([link_to("Editar", edit_customer_path(@customer), class: "button"), (button_to("Desativar", @customer, method: :delete, class: "button danger", data: { turbo_confirm: "Desativar este cliente?" }) if current_user.admin? && @customer.active?)], " ") if current_user.admin?) %><section class="panel detail-grid"><div><span class="detail-label">Status</span><%= status_badge(@customer.status) %></div><div><span class="detail-label">Documento</span><strong><%= @customer.document.presence || "—" %></strong></div><div><span class="detail-label">Telefone</span><strong><%= @customer.phone.presence || "—" %></strong></div></section>
