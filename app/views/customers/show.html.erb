<div class="page-head"><div><p class="eyebrow">CLIENTE</p><h1><%= @customer.name %></h1><p class="muted"><%= @customer.email %></p></div><div><%= link_to "Editar", edit_customer_path(@customer), class: "button" if current_user.admin? %> <%= button_to "Desativar", @customer, method: :delete, class: "button danger", data: { turbo_confirm: "Desativar este cliente?" } if current_user.admin? && @customer.active? %></div></div><section class="panel detail-grid"><div><span>Status</span><%= status_badge(@customer.status) %></div><div><span>Documento</span><strong><%= @customer.document.presence || "—" %></strong></div><div><span>Telefone</span><strong><%= @customer.phone.presence || "—" %></strong></div></section>
