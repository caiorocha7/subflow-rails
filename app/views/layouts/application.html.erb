<!DOCTYPE html>
<html lang="pt-BR"><head><title>SubFlow — Gestão recorrente</title><meta name="viewport" content="width=device-width,initial-scale=1"><%= csrf_meta_tags %><%= csp_meta_tag %><%= stylesheet_link_tag :app, "data-turbo-track": "reload" %></head>
<body class="<%= signed_in? ? 'app-shell' : 'auth-shell' %>"><% if signed_in? %><aside class="sidebar"><a class="brand" href="/"><span class="brand-mark">S</span><span>SubFlow</span></a><p class="workspace-label">WORKSPACE</p><p class="workspace-name"><%= current_account.name %></p><nav class="desktop-nav" aria-label="Navegação principal"><%= navigation_links %></nav><div class="sidebar-user"><div class="avatar"><%= current_user.name.first.upcase %></div><div><strong><%= current_user.name %></strong><small><%= current_user.role.upcase %></small></div><%= button_to logout_path, method: :delete, class: "logout-button", title: "Sair" do %>↗<span class="sr-only">Sair</span><% end %></div></aside><header class="mobile-topbar"><a class="brand" href="/"><span class="brand-mark">S</span><span>SubFlow</span></a><details class="mobile-menu"><summary aria-label="Abrir menu">☰</summary><nav aria-label="Navegação móvel"><%= navigation_links %><%= button_to "Sair", logout_path, method: :delete, class: "mobile-logout" %></nav></details></header><% end %><main class="main"><% flash.each do |type, msg| %><div class="flash flash-<%= type %>" role="status"><span><%= type.to_s == 'alert' ? '!' : '✓' %></span><%= msg %></div><% end %><%= yield %></main></body></html>
