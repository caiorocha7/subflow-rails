<!DOCTYPE html>
<html lang="pt-BR"><head><title>SubFlow</title><meta name="viewport" content="width=device-width,initial-scale=1"><%= csrf_meta_tags %><%= csp_meta_tag %><%= stylesheet_link_tag :app, "data-turbo-track": "reload" %><%= javascript_importmap_tags %></head>
<body class="<%= signed_in? ? 'app-shell' : 'auth-shell' %>"><% if signed_in? %><aside class="sidebar"><a class="brand" href="/">Sub<span>Flow</span></a><p class="workspace"><%= current_account.name %></p><nav><%= link_to "Visão geral", root_path %><%= link_to "Clientes", customers_path %><%= link_to "Planos", plans_path %><%= link_to "Assinaturas", subscriptions_path %><%= link_to "Cobranças", invoices_path %><%= link_to "Eventos", audit_events_path %><%= link_to "Configurações", settings_path %></nav><div class="user"><strong><%= current_user.name %></strong><small><%= current_user.role %></small><%= button_to "Sair", logout_path, method: :delete, class: "link-button" %></div></aside><% end %><main class="main"><% flash.each { |type, msg| %><div class="flash <%= type %>"><%= msg %></div><% } %><%= yield %></main></body></html>
