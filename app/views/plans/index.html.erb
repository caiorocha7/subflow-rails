<%= render "layouts/page_header", eyebrow: "CATÁLOGO", title: "Planos", description: "Defina os produtos recorrentes da sua operação.", action: (link_to("Novo plano", new_plan_path, class: "button primary") if current_user.admin?) %><section class="cards"><% if @plans.any? %><% @plans.each do |plan| %><article class="plan-card"><div><%= status_badge(plan.active? ? "active" : "inactive") %></div><div><h2><%= plan.name %></h2><p><%= plan.description.presence || "Sem descrição cadastrada." %></p></div><div class="plan-price"><%= money(plan.amount_cents) %> <small>/ <%= plan.interval == "monthly" ? "mês" : "ano" %></small></div><%= link_to "Gerenciar plano", plan, class: "button" %></article><% end %><% else %><%= render "layouts/empty_state", title: "Nenhum plano cadastrado", message: "Crie seu primeiro plano para começar a vender assinaturas.", action: (link_to("Novo plano", new_plan_path, class: "button primary") if current_user.admin?) %><% end %></section>
