<div class="page-head"><div><p class="eyebrow">CATÁLOGO</p><h1>Planos</h1></div><%= link_to "Novo plano", new_plan_path, class: "button primary" if current_user.admin? %></div><section class="cards"><% @plans.each do |plan| %><article class="plan-card"><%= status_badge(plan.active? ? "active" : "inactive") %><h2><%= plan.name %></h2><p><%= plan.description %></p><strong><%= money(plan.amount_cents) %><small>/ <%= plan.interval == "monthly" ? "mês" : "ano" %></small></strong><%= link_to "Gerenciar", plan, class: "button" %></article><% end %></section>
