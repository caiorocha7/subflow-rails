<%= form_with model: plan, class: "form-grid" do |f| %><% if plan.errors.any? %><div class="form-error wide"><%= plan.errors.full_messages.to_sentence %></div><% end %><label>Nome<%= f.text_field :name, required: true, autofocus: true %></label><label>Valor em centavos<%= f.number_field :amount_cents, min: 1, required: true %></label><label>Periodicidade<%= f.select :interval, Plan.intervals.keys.map { |i| [i == "monthly" ? "Mensal" : "Anual", i] } %></label><label class="wide">Descrição<%= f.text_area :description %></label><label class="check-label"><%= f.check_box :active %> Plano ativo</label><div class="form-actions"><%= f.submit class: "button primary" %><%= link_to "Cancelar", plans_path, class: "button" %></div><% end %>
