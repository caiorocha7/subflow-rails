<div class="page-head"><div><p class="eyebrow">PLANO</p><h1><%= @plan.name %></h1><p class="muted"><%= @plan.description %></p></div><%= link_to "Editar", edit_plan_path(@plan), class: "button" if current_user.admin? %></div><section class="panel detail-grid"><div><span>Preço</span><strong><%= money(@plan.amount_cents) %></strong></div><div><span>Cobrança</span><strong><%= @plan.interval %></strong></div><div><span>Status</span><%= status_badge(@plan.active? ? "active" : "inactive") %></div></section>
