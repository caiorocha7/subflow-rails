<%= render "layouts/page_header", eyebrow: "PLANO", title: @plan.name, description: @plan.description, action: (link_to("Editar", edit_plan_path(@plan), class: "button") if current_user.admin?) %><section class="panel detail-grid"><div><span class="detail-label">Preço</span><strong><%= money(@plan.amount_cents) %></strong></div><div><span class="detail-label">Cobrança</span><strong><%= @plan.interval == "monthly" ? "Mensal" : "Anual" %></strong></div><div><span class="detail-label">Status</span><%= status_badge(@plan.active? ? "active" : "inactive") %></div></section>
