<%= render "layouts/page_header", eyebrow: "VISÃO GERAL", title: "Bom trabalho, #{current_user.name.split.first}.", description: "Acompanhe a saúde da sua receita recorrente.", action: (link_to("Nova assinatura", new_subscription_path, class: "button primary") if current_user.admin?) %>
<section class="metric-grid"><article class="metric featured"><div class="metric-label">MRR estimado <span class="metric-icon">↗</span></div><strong><%= money(@mrr_cents) %></strong><small>Receita mensal recorrente estimada</small></article><article class="metric"><div class="metric-label">Assinaturas ativas <span class="metric-icon">↻</span></div><strong><%= @counts[:active] %></strong><small>Em cobrança recorrente</small></article><article class="metric"><div class="metric-label">Clientes ativos <span class="metric-icon">◉</span></div><strong><%= @counts[:customers] %></strong><small>Na sua base atual</small></article><article class="metric"><div class="metric-label">Cobranças em aberto <span class="metric-icon">◌</span></div><strong><%= @counts[:open] %></strong><small>Aguardando pagamento</small></article></section>
<section class="dashboard-lower"><article class="panel"><div class="section-heading"><h2>Atividade recente</h2><%= link_to "Ver eventos", audit_events_path %></div><% if @events.any? %><div class="table-wrap"><table class="data-table"><thead><tr><th>Atividade</th><th>Entidade</th><th>Quando</th></tr></thead><tbody><% @events.each do |event| %><tr><td class="entity-name"><%= event.action.tr('.', ' ') %></td><td><%= event.auditable_type %> #<%= event.auditable_id %></td><td><span class="entity-meta"><%= l event.created_at, format: :short %></span></td></tr><% end %></tbody></table></div><% else %><%= render "layouts/empty_state", title: "Sua operação começa aqui", message: "Crie uma assinatura para iniciar o histórico de atividades.", action: (link_to("Nova assinatura", new_subscription_path, class: "button primary") if current_user.admin?) %><% end %></article><aside class="panel"><div class="section-heading"><h2>Status de cobranças</h2></div><div class="status-summary"><% total = @counts.values_at(:open, :paid, :failed).sum; { "Em aberto" => [:open, ""], "Pagas" => [:paid, "paid"], "Com falha" => [:failed, "failed"] }.each do |name, (key, style)| %><div class="status-row"><span><%= name %></span><div class="status-track"><div class="status-fill <%= style %>" style="width: <%= total.positive? ? (@counts[key].to_f / total * 100).round : 0 %>%"></div></div><strong><%= @counts[key] %></strong></div><% end %></div></aside></section>
