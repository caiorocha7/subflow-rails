<div class="page-head"><div><p class="eyebrow">VISÃO GERAL</p><h1>Bom trabalho, <%= current_user.name.split.first %>.</h1><p class="muted">Sua operação recorrente em um só lugar.</p></div><%= link_to "Nova assinatura", new_subscription_path, class: "button primary" if current_user.admin? %></div><section class="metric-grid"><article class="metric featured"><span>MRR estimado</span><strong><%= money(@mrr_cents) %></strong><small>Receita mensal recorrente estimada</small></article><article class="metric"><span>Assinaturas ativas</span><strong><%= @counts[:active] %></strong></article><article class="metric"><span>Clientes ativos</span><strong><%= @counts[:customers] %></strong></article><article class="metric"><span>Em aberto</span><strong><%= @counts[:open] %></strong></article><article class="metric"><span>Pagas</span><strong><%= @counts[:paid] %></strong></article><article class="metric"><span>Com falha</span><strong><%= @counts[:failed] %></strong></article></section><section class="panel"><div class="panel-head"><h2>Atividade recente</h2><%= link_to "Ver todos", audit_events_path %></div><% if @events.any? %><table><thead><tr><th>Ação</th><th>Entidade</th><th>Quando</th></tr></thead><tbody><% @events.each do |event| %><tr><td><strong><%= event.action.tr('.', ' ') %></strong></td><td><%= event.auditable_type %> #<%= event.auditable_id %></td><td><%= l event.created_at, format: :short %></td></tr><% end %></tbody></table><% else %><div class="empty">Ainda não há eventos. Crie uma assinatura para iniciar seu histórico.</div><% end %></section>
