<%= render "layouts/page_header", eyebrow: "COBRANÇAS", title: "Faturas", description: "Acompanhe os lançamentos simulados da sua operação." %><section class="panel"><div class="simulation"><strong>PAGAMENTOS SIMULADOS</strong><span>Esta área é exclusiva para testes e não processa dinheiro real.</span></div><% if @invoices.any? %><div class="table-wrap"><table class="data-table"><thead><tr><th>Cliente</th><th>Assinatura</th><th>Valor</th><th>Vencimento</th><th>Status</th><th></th></tr></thead><tbody><% @invoices.each do |invoice| %><tr><td><span class="entity-name"><%= invoice.customer.name %></span><span class="entity-meta">Fatura #<%= invoice.id %></span></td><td><%= invoice.subscription.plan.name %></td><td class="entity-name"><%= money(invoice.amount_cents) %></td><td><%= format_date(invoice.due_on) %></td><td><%= status_badge(invoice.status) %></td><td><%= link_to "Ver fatura →", invoice, class: "table-link" %></td></tr><% end %></tbody></table></div><% if @total_pages > 1 %><nav class="pagination" aria-label="Paginação de faturas"><span>Página <strong><%= @page %></strong> de <strong><%= @total_pages %></strong></span><div class="pagination-links"><%= link_to "← Anterior", invoices_path(page: @page - 1), class: "button", aria: { disabled: @page == 1 } %><%= link_to "Próxima →", invoices_path(page: @page + 1), class: "button", aria: { disabled: @page == @total_pages } %></div></nav><% end %><% else %><%= render "layouts/empty_state", title: "Nenhuma fatura", message: "As cobranças geradas aparecerão aqui." %><% end %></section>
