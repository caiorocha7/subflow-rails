<% simulation = current_user.admin? && @invoice.open? ? content_tag(:div, class: "simulation") { safe_join([content_tag(:strong, "PAGAMENTO SIMULADO"), button_to("Aprovar", simulate_payment_invoice_path(@invoice, outcome: "succeeded"), class: "button primary"), button_to("Simular falha", simulate_payment_invoice_path(@invoice, outcome: "failed"), class: "button danger")]) } : nil %><%= render "layouts/page_header", eyebrow: "COBRANÇA SIMULADA ##{@invoice.id}", title: money(@invoice.amount_cents), description: "Esta cobrança não processa dinheiro real.", action: simulation %><section class="panel detail-grid"><div><span class="detail-label">Status</span><%= status_badge(@invoice.status) %></div><div><span class="detail-label">Cliente</span><strong><%= @invoice.customer.name %></strong></div><div><span class="detail-label">Vencimento</span><strong><%= l @invoice.due_on %></strong></div></section><section class="panel"><div class="section-heading"><h2>Período de cobrança</h2></div><strong><%= @invoice.period_start %> — <%= @invoice.period_end %></strong></section>
