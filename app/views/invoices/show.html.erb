<div class="page-head"><div><p class="eyebrow">COBRANÇA SIMULADA #<%= @invoice.id %></p><h1><%= money(@invoice.amount_cents) %></h1><p><%= status_badge(@invoice.status) %></p></div><% if current_user.admin? && @invoice.open? %><div class="simulation"><strong>SIMULAÇÃO LOCAL</strong><%= button_to "Simular pagamento aprovado", simulate_payment_invoice_path(@invoice, outcome: "succeeded"), class: "button primary" %><%= button_to "Simular falha", simulate_payment_invoice_path(@invoice, outcome: "failed"), class: "button danger" %></div><% end %></div><section class="panel detail-grid"><div><span>Cliente</span><strong><%= @invoice.customer.name %></strong></div><div><span>Vencimento</span><strong><%= l @invoice.due_on %></strong></div><div><span>Período</span><strong><%= @invoice.period_start %> — <%= @invoice.period_end %></strong></div></section>
