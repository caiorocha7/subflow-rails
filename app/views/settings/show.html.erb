<%= render "layouts/page_header", eyebrow: "WORKSPACE", title: "Configurações", description: "Atualize as informações da sua empresa." %><section class="panel form-card"><%= form_with model: current_account, url: settings_path, method: :patch, class: "form-grid" do |f| %><label class="wide">Nome da empresa<%= f.text_field :name, required: true %></label><div class="form-actions"><%= f.submit "Salvar alterações", class: "button primary" %></div><% end %></section><section class="panel form-card"><div class="section-heading"><h2>API</h2></div><p class="page-description">A API usa token Bearer gerado nos dados de demonstração. Nunca exponha esse token em aplicações públicas.</p></section>
